# Copy to .env next to this file before the first `docker compose up`.
# .env is gitignored — it's host-specific, not secret material.

# The domain you've pointed at this server (DNS A/AAAA record). Caddy
# requests and auto-renews a Let's Encrypt certificate for it.
WR_DOMAIN=remote.example.de

# Optional: contact address for Let's Encrypt renewal/expiry notices.
# ACME_EMAIL=admin@example.de
