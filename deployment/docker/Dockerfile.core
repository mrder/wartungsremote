# Build and runtime image for wr-core. See docs/DEPLOYMENT.md.
FROM golang:1.26-alpine AS build
WORKDIR /src

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/wr-core ./cmd/wr-core

FROM gcr.io/distroless/static-debian12:nonroot AS runtime
WORKDIR /app

COPY --from=build /out/wr-core /app/wr-core
COPY docs /app/docs

USER nonroot:nonroot
EXPOSE 8443 9443

ENTRYPOINT ["/app/wr-core"]
